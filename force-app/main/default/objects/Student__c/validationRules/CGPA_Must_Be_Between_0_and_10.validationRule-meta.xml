<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CGPA_Must_Be_Between_0_and_10</fullName>
    <active>true</active>
    <description>Ensures that the student&apos;s CGPA is between 0 and 10.</description>
    <errorConditionFormula>OR(
    CGPA__c &lt; 0,
    CGPA__c &gt; 10
)</errorConditionFormula>
    <errorDisplayField>CGPA__c</errorDisplayField>
    <errorMessage>CGPA must be between 0 and 10.</errorMessage>
</ValidationRule>
